<?xml version="1.0" encoding="utf-8"?>
<!-- Modèle du manifeste MSIX (Microsoft Store). Les champs entre accolades sont remplis par tools/build_msix.py
     depuis packaging/msix/identity.json et mailclient/__init__.py. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  IgnorableNamespaces="uap rescap desktop uap10">

  <Identity Name="{name}" Publisher="{publisher}" Version="{version}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{display_name}</DisplayName>
    <PublisherDisplayName>{publisher_display_name}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Client mail de bureau Windows (IMAP/SMTP).</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="fr-FR" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="Smail" Executable="Smail.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{display_name}"
        Description="Client mail de bureau Windows (IMAP/SMTP)"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Liens « mailto: » : Smail proposé comme messagerie par défaut (choix de l’utilisateur). -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="mailto">
            <uap:DisplayName>Smail</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
    <!-- Lancement à l’ouverture de session (désactivé par défaut, activable dans Paramètres › Applications ›
         Démarrage) : entrée invisible qui démarre Smail réduit dans la zone de notification (paramètre « minimized »). -->
    <Application Id="SmailStartup" Executable="Smail.exe" EntryPoint="Windows.FullTrustApplication" uap10:Parameters="--minimized">
      <uap:VisualElements
        DisplayName="{display_name}"
        Description="Client mail de bureau Windows (IMAP/SMTP)"
        BackgroundColor="transparent"
        AppListEntry="none"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="Smail.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="SmailStartup" Enabled="false" DisplayName="Smail" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- Application de bureau classique (PySide6 / Qt WebEngine) : exécution en confiance totale. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
